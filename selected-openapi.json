{
  "openapi": "3.1.0",
  "info": {
    "title": "DigitalOcean selected operations",
    "version": "0.2.0",
    "description": "Reviewed local connector bindings for manual API import. No provider credentials are included; authentication and hosted execution require separate configuration and tests."
  },
  "servers": [
    {
      "url": "https://api.digitalocean.com/v2"
    }
  ],
  "paths": {
    "/projects": {
      "get": {
        "operationId": "list_projects",
        "summary": "List projects.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          }
        ],
        "x-pipmcp-read-only": true,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        }
      },
      "post": {
        "operationId": "create_project",
        "summary": "Create project.",
        "parameters": [],
        "x-pipmcp-read-only": false,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048,
                    "description": "Value"
                  },
                  "purpose": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048,
                    "description": "Value"
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048,
                    "description": "Value"
                  },
                  "environment": {
                    "type": "string",
                    "enum": [
                      "Development",
                      "Staging",
                      "Production"
                    ]
                  }
                },
                "required": [
                  "name",
                  "purpose"
                ]
              }
            }
          }
        }
      }
    },
    "/droplets": {
      "get": {
        "operationId": "list_droplets",
        "summary": "List droplets.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          }
        ],
        "x-pipmcp-read-only": true,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "providerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "security": [
    {
      "providerAuth": []
    }
  ]
}
